# Copier en .env à la racine, puis : docker compose up -d --build
# Générer chaque secret avec : openssl rand -base64 32
POSTGRES_PASSWORD=
ERP_OWNER_PASSWORD=
ERP_APP_PASSWORD=
# Rôle du Super Admin (sans droits de propriétaire).
ERP_PLATFORM_PASSWORD=
# Rôles des groupes scolaires (console du groupe, chiffres agrégés), voir infra/postgres/roles-groupes.sh.
ERP_GROUP_PASSWORD=
ERP_STATS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_ENCRYPTION_KEY=

# Adresse publique du site (sert aux liens envoyés par SMS et aux retours de paiement).
WEB_ORIGIN=http://localhost:8080
HTTP_PORT=8080
# Nom de domaine pour le HTTPS automatique (ex. ecole.exemple.bj). Laisser :80 en local.
SITE_ADDRESS=:80
# En local sans HTTPS uniquement : false. En production : true.
COOKIE_SECURE=false

# Une seule école : son identifiant. Plateforme multi-écoles : laisser vide.
TENANT_SLUG=saint-kisito
# Plateforme multi-écoles : domaine sous lequel chaque école a son adresse (ex. ecoles.exemple.bj donne
# kisito.ecoles.exemple.bj). Domaine à acheter : INFORMATION MANQUANTE. Avec un domaine, mettre SITE_ADDRESS=https://
PLATFORM_DOMAIN=
# Afficher les comptes de démonstration sur la page de connexion (false en production).
SHOW_DEMO_ACCOUNTS=true
# Serveur qui héberge de vraies écoles : true (l'installateur l'ajoute). Le jeu de démonstration y est alors refusé (SEC-038).
PRODUCTION_SERVER=false

# Paiement : sandbox tant que le contrat agrégateur n'est pas signé (INFORMATION MANQUANTE).
# En production, le bac à sable est fermé (paiement en ligne indisponible, guichet seulement) sauf si
# ALLOW_SANDBOX_PAYMENTS=true : à réserver à un serveur de démonstration, jamais avec de vrais élèves.
PAYMENT_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS=false
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# SMS : « console » (rien n'est envoyé) ou « bulkgate » (Côte d'Ivoire, Bénin...).
SMS_PROVIDER=console
# Avec SMS_PROVIDER=bulkgate : portail BulkGate > Modules et API > API > Simple API (identifiant et jeton).
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
# Nom d'expéditeur par défaut, une fois enregistré (11 caractères, sans accent). Chaque école peut avoir le sien (Super Admin).
SMS_SENDER=
# Sans fournisseur, les SMS ne partent pas. true : leur texte (mots de passe, codes) est écrit dans les
# journaux, pour un poste de démonstration. Sur un vrai serveur : false (posé par installer-serveur.sh, SEC-044).
SMS_CONSOLE_SHOW_TEXT=true
# Documentation de l'API sur /api/docs : true sur un poste de développement seulement (SEC-045).
API_DOCS=false
