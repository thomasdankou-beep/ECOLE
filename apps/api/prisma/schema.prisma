// Modèle de données de l'ERP scolaire.
// Règles communes (cahier des charges §5.3) :
// - chaque table métier porte tenant_id, protégé par la Row Level Security (voir migrations/*_rls) ;
// - les notes, paiements, reçus et décisions ne sont jamais supprimés physiquement ;
// - montants en FCFA entiers, notes en décimal au centième.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_ADMIN_URL")
}

// ---------------------------------------------------------------- Organisation

/// École cliente (établissement) avec ses sites. Elle appartient toujours à un groupe scolaire (lot G1, D-G1).
model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  name          String
  shortName     String?
  country       String       @default("BJ")
  currency      String       @default("XOF")
  timezone      String       @default("Africa/Porto-Novo")
  /// Paramètres : seuils de distinction, règles de calcul, blocage bulletin si impayé, canaux de notification...
  settings      Json         @default("{}")
  /// Suspendu par la plateforme : plus aucune connexion possible, données conservées.
  status        TenantStatus @default(ACTIVE)
  /// Nom de domaine propre à l'école (facultatif), en plus du sous-domaine <slug>.<domaine de la plateforme>.
  domain        String?      @unique
  /// Notes internes de la plateforme (contrat, contact), jamais visibles par l'école.
  platformNotes String?
  /// Groupe scolaire de l'école (D-G1) : une école indépendante forme un groupe à elle seule, à son nom.
  /// Seul le Super Admin le change (rattacher, détacher). Jamais lu par le rôle des écoles (voir PrismaService).
  groupId       String       @map("group_id") @db.Uuid
  group         SchoolGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  /// Date du rattachement à ce groupe.
  groupJoinedAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Facturation de Cahiora (lot G5a) : zone de la plateforme, jamais lue par le rôle des écoles.
  subscription           Subscription?
  billingCalendars       BillingCalendar[]
  /// Prestations complémentaires (lot G5g) : tarifs particuliers, remises et gratuités propres à l'établissement.
  serviceRates           ServiceRate[]
  /// Comptages des élèves facturables (lot G5b) : des nombres seulement, la liste nominative reste dans l'école.
  billingCounts          BillingCount[]
  /// Lignes des documents provisoires de Cahiora (lot G5c) qui concernent l'établissement.
  billingDocumentLines   BillingDocumentLine[]
  /// Demandes de régularisation de la direction (lot G5d-1) : zone de la plateforme, lues par l'école par ses fonctions.
  regularizationRequests RegularizationRequest[]

  @@index([groupId])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Groupe scolaire, ou compte client (lot G1) : regroupe une ou plusieurs écoles.
/// Zone de la plateforme : aucun droit pour le rôle des écoles ; le rôle du groupe (erp_group) ne lit que sa
/// propre fiche, sans les notes internes (Row Level Security sur app.group_id, migration groupes_g1).
/// Un groupe qui a des écoles ne peut pas être supprimé.
model SchoolGroup {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  /// Raison sociale du promoteur (facultative).
  legalName        String?
  promoter         String?
  phone            String?
  email            String?
  address          String?
  country          String            @default("BJ")
  /// Identifiant fiscal (facultatif).
  taxId            String?
  /// Suspendu par le Super Admin : les comptes du groupe perdent aussitôt l'accès à leur console (lot G2).
  /// Sans effet sur les écoles.
  status           GroupStatus       @default(ACTIVE)
  /// Notes internes de la plateforme, jamais visibles par le groupe ni par les écoles.
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenants          Tenant[]
  accounts         GroupAccount[]
  /// Documents provisoires de Cahiora adressés au groupe, client de la facturation (lot G5c).
  billingDocuments BillingDocument[]

  @@map("school_groups")
}

enum GroupStatus {
  ACTIVE
  SUSPENDED
}

/// Journal du groupe, en ajout seul (déclencheur forbid_change). Sans clé étrangère : il survit à la
/// suppression d'un groupe vide. Les écoles y figurent par leur nom dans « data », jamais par une colonne
/// tenant_id (le rôle du groupe n'a aucun droit sur les tables qui portent une école).
model GroupAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  /// platform (Super Admin), system (mise à jour de Cahiora) ; group (comptes du groupe, lot G2).
  actorKind String
  actorId   String?  @db.Uuid
  actorName String?
  action    String
  data      Json?
  /// Adresse IP des actions des comptes du groupe (lot G2) ; jamais celle du Super Admin.
  ip        String?
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("group_audit_logs")
}

/// Rôle d'un compte de la console du groupe (lot G2, décision D-G4).
enum GroupRole {
  /// Responsable général : tout ce que voit le groupe, plus les comptes du groupe et son journal.
  GENERAL
  /// Responsable financier : chiffres financiers et factures Cahiora (lots G3 et G5).
  FINANCIER
  /// Responsable pédagogique (facultatif) : effectifs, assiduité et résultats (lot G3).
  PEDAGOGIQUE
}

/// Compte de la console du groupe (lot G2) : le promoteur et les personnes qu'il désigne. Séparé des comptes
/// d'école et du Super Admin : ses jetons sont refusés par les deux autres espaces. Zone du rôle erp_group
/// (Row Level Security sur app.group_id) ; jamais supprimé, seulement désactivé.
/// Double authentification obligatoire (D-G5) : aucune session n'est ouverte tant qu'elle n'est pas active.
model GroupAccount {
  id                 String      @id @default(uuid()) @db.Uuid
  groupId            String      @map("group_id") @db.Uuid
  group              SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  firstName          String
  lastName           String
  /// Identifiant de connexion : téléphone (format international) ou e-mail, uniques entre tous les groupes.
  phone              String?     @unique
  email              String?     @unique
  passwordHash       String
  role               GroupRole
  /// Désactivé : plus aucune connexion, sessions refusées dès l'appel suivant.
  active             Boolean     @default(true)
  /// Mot de passe provisoire remis par le Super Admin ou le responsable général : à changer à la première connexion.
  mustChangePassword Boolean     @default(true)
  passwordChangedAt  DateTime?
  failedLogins       Int         @default(0)
  lockedUntil        DateTime?
  /// Secret de l'application d'authentification, chiffré (AES-256-GCM).
  totpSecret         String?
  totpEnabled        Boolean     @default(false)
  /// Pas de temps (30 s) du dernier code accepté : un code ne sert qu'une fois.
  totpLastStep       Int?
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  recoveryCodes GroupRecoveryCode[]
  sessions      GroupSession[]

  @@unique([id, groupId])
  @@index([groupId])
  @@map("group_accounts")
}

/// Code de récupération d'un compte de groupe : seule son empreinte est gardée, il ne sert qu'une fois.
model GroupRecoveryCode {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  /// Groupe du compte (clé étrangère composée) : la Row Level Security filtre sans jointure.
  groupId   String       @map("group_id") @db.Uuid
  account   GroupAccount @relation(fields: [accountId, groupId], references: [id, groupId], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@unique([accountId, codeHash])
  @@map("group_recovery_codes")
}

/// Session de la console du groupe, vérifiée en base à chaque appel : 8 heures au plus, 30 minutes sans activité,
/// révocable une à une (déconnexion, appareil perdu, compte désactivé, mot de passe changé).
model GroupSession {
  id            String       @id @default(uuid()) @db.Uuid
  accountId     String       @map("account_id") @db.Uuid
  groupId       String       @map("group_id") @db.Uuid
  account       GroupAccount @relation(fields: [accountId, groupId], references: [id, groupId], onDelete: Cascade)
  ip            String?
  userAgent     String?
  createdAt     DateTime     @default(now())
  lastUsedAt    DateTime     @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([accountId])
  @@map("group_sessions")
}

// ---------------------------------------------------------------- Plateforme (éditeur du logiciel)

/// Compte Super Admin de la plateforme : crée et suit les écoles clientes, sans accès à leurs données métier.
model PlatformAdmin {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  active             Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Mot de passe remis par la ligne de commande : à changer à la première connexion.
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  /// Double authentification du Super Admin (SEC-021).
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  totpLastStep       Int?
  /// Déconnexion : tout jeton émis avant cette date est refusé (SEC-021).
  sessionsRevokedAt  DateTime?
  /// Récupération exceptionnelle : une nouvelle double authentification est exigée avant tout autre écran.
  mustSetupTwoFactor Boolean   @default(false)
  createdAt          DateTime  @default(now())

  recoveryCodes PlatformRecoveryCode[]

  @@map("platform_admins")
}

/// Code de récupération du Super Admin : seule son empreinte est gardée, il ne sert qu'une fois.
model PlatformRecoveryCode {
  id        String        @id @default(uuid()) @db.Uuid
  adminId   String        @db.Uuid
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@unique([adminId, codeHash])
  @@map("platform_recovery_codes")
}

/// Journal des actions de la plateforme (création, suspension d'école…), en ajout seul.
model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  action    String
  tenantId  String?  @db.Uuid
  data      Json?
  /// Adresse IP de l'action (SEC-036).
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------- Facturation de Cahiora (lot G5)
// Zone de la plateforme : le rôle des écoles (erp_app) n'a aucun droit sur ces tables. La direction lit son
// abonnement et accepte les conditions par des fonctions limitées à son école (migration facturation_g5a).
// Montants en entiers dans la monnaie de l'établissement ; dates de calendrier sans heure.

/// Paramètre tarifaire daté (cahier des charges G5, §2 et §15). Un changement ajoute une version avec sa date
/// d'effet, jamais une modification : la table est en ajout seul (forbid_change). La valeur en vigueur un jour donné
/// est la version de date d'effet la plus récente jusqu'à ce jour (à date égale, la dernière enregistrée).
model BillingParameter {
  id            String   @id @default(uuid()) @db.Uuid
  key           String
  /// Monnaie d'un montant (XOF…) ; vide pour une durée ou un pourcentage.
  currency      String?
  /// Montant dans la monnaie, nombre d'heures, de jours ou de mois, ou pourcentage en centièmes (1500 = 15 %).
  value         Int
  effectiveFrom DateTime @db.Date
  reason        String
  createdById   String?  @db.Uuid
  createdByName String
  createdAt     DateTime @default(now())

  @@index([key, currency, effectiveFrom])
  @@map("billing_parameters")
}

/// Calendrier de facturation d'un établissement pour une année scolaire (§3) : début, fin, préparation, comptage
/// initial, régularisations et renouvellement. Chaque modification ajoute une version (en ajout seul) ; une date
/// passée ne change jamais.
model BillingCalendar {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  yearLabel               String
  version                 Int
  startDate               DateTime  @db.Date
  endDate                 DateTime  @db.Date
  preparationFrom         DateTime? @db.Date
  initialCountDate        DateTime  @db.Date
  firstRegularizationDate DateTime  @db.Date
  finalRegularizationDate DateTime  @db.Date
  renewalDate             DateTime? @db.Date
  /// Formule qui a proposé les dates : B ou A (D-G5-28 en attente, provisoire) ; MANUEL si saisies à la main.
  formula                 String
  reason                  String
  createdById             String?   @db.Uuid
  createdByName           String
  createdAt               DateTime  @default(now())

  @@unique([tenantId, yearLabel, version])
  @@map("billing_calendars")
}

enum SubscriptionStatus {
  /// Essai gratuit (14 jours par défaut, paramètre daté).
  TRIAL
  /// École pilote partenaire CAHIORA : gratuité de quelques mois à partir de l'activation effective (§13).
  PILOT
  /// Essai ou pilote terminé : l'établissement doit accepter les conditions commerciales.
  AWAITING_ACCEPTANCE
  /// Conditions acceptées : demande de paiement, en attente du paiement vérifié (lots G5c et G5d).
  AWAITING_PAYMENT
  /// Abonnement payé et activé (lot G5d).
  ACTIVE
  /// Accès limité, sans suppression de données : restrictions appliquées après la décision D-G5-30.
  LIMITED
}

/// Abonnement d'un établissement à Cahiora (§4 et §13) : un seul par établissement, jamais supprimé. L'état change
/// par des transitions contrôlées, chacune inscrite dans subscription_events (en ajout seul).
model Subscription {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @unique @map("tenant_id") @db.Uuid
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status                 SubscriptionStatus
  statusSince            DateTime                @default(now())
  trialStart             DateTime?               @db.Date
  trialEnd               DateTime?               @db.Date
  trialDays              Int?
  pilotStart             DateTime?               @db.Date
  pilotEnd               DateTime?               @db.Date
  pilotMonths            Int?
  /// Conditions commerciales acceptées par la direction : version, date et auteur.
  acceptedTermsId        String?                 @db.Uuid
  acceptedAt             DateTime?
  acceptedByName         String?
  /// Tarif en vigueur le jour de l'acceptation, figé : un changement de tarif ultérieur ne le modifie jamais (§2).
  acceptedTariff         Json?
  /// Délai de grâce après la fin de la gratuité (lot G5d-1, D-G5-30 A) : accès complet du premier au dernier jour.
  /// Fixé une seule fois, au passage en attente ; vide pour une gratuité finie avant ce lot (jamais limitée seule).
  graceStart             DateTime?               @db.Date
  graceEnd               DateTime?               @db.Date
  /// Prolongation exceptionnelle du Super Admin (D-G5-43 A) : accès complet jusqu'à ce jour inclus.
  extendedUntil          DateTime?               @db.Date
  /// Début de l'accès limité (statut LIMITED), posé par la tâche planifiée.
  limitedSince           DateTime?
  /// Préavis après la réponse de Cahiora à une demande de régularisation (lecture 7 A, 20 novembre 2026) : fin du
  /// préavis, et fin du délai de grâce de l'échéance pour laquelle il a été donné (une seule fois par échéance).
  noticeUntil            DateTime?
  noticeGraceEnd         DateTime?               @db.Date
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  events                 SubscriptionEvent[]
  regularizationRequests RegularizationRequest[]

  @@map("subscriptions")
}

enum RegularizationRequestStatus {
  PENDING
  ANSWERED
}

/// Demande de régularisation de la direction (lot G5d-1, D-G5-42 A) : horodatée et journalisée ; seule la réponse de
/// Cahiora s'y inscrit, une fois. Zone de la plateforme : l'école la lit et l'écrit par ses fonctions de la base.
model RegularizationRequest {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId     String                      @db.Uuid
  subscription       Subscription                @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  status             RegularizationRequestStatus @default(PENDING)
  /// État de l'abonnement au moment de la demande (en attente ou accès limité).
  subscriptionStatus SubscriptionStatus
  message            String?
  requestedById      String?                     @db.Uuid
  requestedByName    String
  requestedAt        DateTime                    @default(now())
  ip                 String?
  answeredById       String?                     @db.Uuid
  answeredByName     String?
  answeredAt         DateTime?
  /// Réponse de Cahiora, lue par la direction (signée « Cahiora »).
  answer             String?

  @@index([tenantId, requestedAt])
  @@map("regularization_requests")
}

/// Historique d'un abonnement, en ajout seul : ouverture, dates du pilote, fin d'essai, acceptation…
model SubscriptionEvent {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @db.Uuid
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  tenantId       String              @map("tenant_id") @db.Uuid
  kind           String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  data           Json?
  /// Motif saisi par le Super Admin : jamais montré à l'école.
  reason         String?
  /// platform (Super Admin), school (direction), system (tâche planifiée).
  actorKind      String
  actorId        String?             @db.Uuid
  actorName      String
  ip             String?
  createdAt      DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@map("subscription_events")
}

/// Conditions commerciales publiées par Cahiora, versionnées, que la direction accepte à la fin de l'essai.
/// Le texte vient de Dankou (INFORMATION MANQUANTE tant qu'il n'est pas publié) ; en ajout seul.
model CommercialTerms {
  id            String   @id @default(uuid()) @db.Uuid
  version       Int      @unique
  title         String
  body          String
  effectiveFrom DateTime @db.Date
  createdById   String?  @db.Uuid
  createdByName String
  createdAt     DateTime @default(now())

  @@map("commercial_terms")
}

/// Tâche planifiée déjà exécutée (fin d'essai, alerte ou fin de pilote) : la clé unique, écrite dans la même
/// transaction que l'effet, garantit qu'une tâche relancée ne produit jamais de doublon. En ajout seul.
model BillingJob {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  kind      String
  tenantId  String?  @map("tenant_id") @db.Uuid
  dueDate   DateTime @db.Date
  result    Json?
  createdAt DateTime @default(now())

  @@map("billing_jobs")
}

/// Alerte du tableau de bord du Super Admin (fin d'essai, pilote bientôt terminé…). Jamais supprimée.
model PlatformAlert {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  kind      String
  message   String
  dueDate   DateTime? @db.Date
  readAt    DateTime?
  readById  String?   @db.Uuid
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("platform_alerts")
}

// Prestations complémentaires de Cahiora (lot G5g, cahier des charges G5 §7 et §15) : zone de la plateforme, sans
// aucun droit pour les écoles, les groupes ni les statistiques. Tout est en ajout seul (forbid_change).

/// Prestation du catalogue (formation, paramétrage…). Jamais rattachée d'office à un établissement : elle n'entre
/// dans un devis ou une facture que si quelqu'un l'y ajoute (lot G5c). Son nom, sa description, son mode de prix et
/// son activation sont des versions datées ; ses prix, remises, tarifs particuliers et gratuités, des règles datées.
model Service {
  id            String                @id @default(uuid()) @db.Uuid
  /// Code stable tiré du premier nom (FORMATION_ET_PRISE_EN_MAIN), pour les documents et les journaux.
  code          String                @unique
  createdById   String?               @db.Uuid
  createdByName String
  createdAt     DateTime              @default(now())
  versions      ServiceVersion[]
  rates         ServiceRate[]
  documentLines BillingDocumentLine[]

  @@map("services")
}

enum ServicePricing {
  FIXED
  FREE
  QUOTE
}

/// Version d'une prestation, avec sa date d'effet (jamais passée). La version en vigueur un jour donné est celle de
/// date d'effet la plus récente jusqu'à ce jour ; à date égale, la dernière inscrite.
model ServiceVersion {
  id            String         @id @default(uuid()) @db.Uuid
  serviceId     String         @db.Uuid
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  version       Int
  name          String
  /// Contenu de la prestation ; vide tant que Cahiora ne l'a pas rédigé (INFORMATION MANQUANTE).
  description   String?
  pricing       ServicePricing
  /// Désactivée : plus proposée dans un nouveau devis ou une nouvelle facture à partir de sa date d'effet.
  active        Boolean
  effectiveFrom DateTime       @db.Date
  reason        String
  createdById   String?        @db.Uuid
  createdByName String
  createdAt     DateTime       @default(now())

  @@unique([serviceId, version])
  @@map("service_versions")
}

enum ServiceRateKind {
  PRICE
  SPECIAL_PRICE
  DISCOUNT_PERCENT
  DISCOUNT_AMOUNT
  FREE
}

/// Règle de prix datée : prix du catalogue (tous les établissements, sans fin), tarif particulier d'un établissement,
/// remise (pourcentage ou montant) ou gratuité, pour un établissement ou pour tous. Une seule règle s'applique à la
/// fois, jamais de cumul (services-rules.ts).
model ServiceRate {
  id            String          @id @default(uuid()) @db.Uuid
  serviceId     String          @db.Uuid
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  /// Établissement visé ; vide : tous les établissements.
  tenantId      String?         @map("tenant_id") @db.Uuid
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind          ServiceRateKind
  /// Monnaie d'un montant ; vide pour un pourcentage ou une gratuité.
  currency      String?
  /// Montant dans la monnaie, ou pourcentage en centièmes (1500 = 15 %) ; vide pour une gratuité.
  value         Int?
  effectiveFrom DateTime        @db.Date
  /// Dernier jour prévu à la création ; vide : sans fin. Un arrêt plus tôt est une ligne de service_rate_ends.
  effectiveTo   DateTime?       @db.Date
  reason        String
  createdById   String?         @db.Uuid
  createdByName String
  createdAt     DateTime        @default(now())
  stop          ServiceRateEnd?

  @@index([serviceId, effectiveFrom])
  @@index([tenantId])
  @@map("service_rates")
}

/// Arrêt d'une règle avant son dernier jour prévu (ou annulation avant son début), une seule fois, avec un motif.
model ServiceRateEnd {
  id            String      @id @default(uuid()) @db.Uuid
  rateId        String      @unique @db.Uuid
  rate          ServiceRate @relation(fields: [rateId], references: [id], onDelete: Restrict)
  lastDay       DateTime    @db.Date
  reason        String
  createdById   String?     @db.Uuid
  createdByName String
  createdAt     DateTime    @default(now())

  @@map("service_rate_ends")
}

// ---------------------------------------------------------------- Comptages des élèves facturables (lot G5b)
// Cahier des charges G5 (§5) et décisions de Dankou du 19 novembre 2026 (D-G5-13 B, D-G5-14 A, D-G5-16 A). Le
// comptage lui-même (nombres, empreinte) est dans la zone de la plateforme ; la liste des inscriptions comptées et les
// demandes de correction restent dans l'espace de l'école (Row Level Security de l'établissement). Tout s'écrit par des
// fonctions de la base qui refont chaque contrôle (migration comptages_g5b). Aucun montant, aucune facture ici.

enum BillingCountKind {
  /// Fin de l'essai gratuit : comptage à la fin du dernier jour gratuit, figé aussitôt (première facture, lot G5c).
  TRIAL_END
  /// Fin de la période pilote : même règle.
  PILOT_END
  /// Comptage initial (date R) du calendrier de l'établissement.
  INITIAL
  /// Première régularisation du calendrier.
  FIRST_REGULARIZATION
  /// Régularisation finale du calendrier.
  FINAL_REGULARIZATION
}

enum BillingCountStage {
  /// Le lendemain de la date : ouvre la vérification par la direction (COUNT_REVIEW_DAYS jours, 15 par défaut).
  PROVISIONAL
  /// Instantané définitif, à la fin de la vérification (ou aussitôt pour une fin d'essai ou de pilote) : il ne change plus.
  FROZEN
}

/// Comptage des élèves facturables d'un établissement à une date (zone de la plateforme) : type, étape, nombre, cumul de
/// l'année, éléments à vérifier, exclusions et empreinte de la liste, jamais un nom. En ajout seul, une seule ligne par
/// établissement, année, type, date et étape : une tâche relancée ne crée jamais de doublon.
model BillingCount {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  yearLabel       String
  academicYearId  String               @db.Uuid
  academicYear    AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  kind            BillingCountKind
  /// Jour de référence, compté jusqu'à minuit dans le fuseau de l'établissement.
  referenceDate   DateTime             @db.Date
  stage           BillingCountStage
  /// Version du calendrier de facturation qui a donné la date (comptages du calendrier).
  calendarVersion Int?
  /// Inscriptions comptées à la date.
  pupils          Int
  /// Élèves comptés au moins une fois dans l'année, dans les comptages figés jusqu'à celui-ci (une fois par élève et par
  /// année), moins les exclusions validées.
  cumulative      Int
  /// Inscriptions comptées dont le départ, enregistré avant l'historique des inscriptions, n'a pas de date confirmée.
  toCheck         Int
  /// Inscriptions retirées du comptage par une exclusion validée.
  excluded        Int
  /// Empreinte SHA-256 de la liste (inscription, motif, date de départ), pour prouver qu'elle n'a pas changé.
  listHash        String
  /// Fin du jour de référence (instant) et état de l'historique lu (instant) : refaire le calcul donne la même liste.
  at              DateTime
  knownAt         DateTime
  /// Dernier jour de la vérification par la direction (comptage provisoire seulement).
  reviewUntil     DateTime?            @db.Date
  timeZone        String
  createdAt       DateTime             @default(now())
  items           BillingCountItem[]
  corrections     CountCorrection[]
  /// Ligne du document d'abonnement qui facture ce comptage figé (lot G5c) : une seule.
  documentLine    BillingDocumentLine?

  @@unique([tenantId, yearLabel, kind, referenceDate, stage])
  @@index([tenantId, createdAt])
  @@map("billing_counts")
}

/// Ligne d'un comptage (espace de l'école) : une inscription comptée, ou retirée par une exclusion validée. La classe et
/// le site sont ceux de la date de référence. En ajout seul ; ni la plateforme ni le groupe ne la lisent.
model BillingCountItem {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  countId       String       @db.Uuid
  count         BillingCount @relation(fields: [countId], references: [id], onDelete: Restrict)
  enrollmentId  String       @db.Uuid
  enrollment    Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  classId       String       @db.Uuid
  siteId        String?      @db.Uuid
  counted       Boolean
  /// ACTIVE (inscription active à la date), DEPARTURE_AUDIT (départ d'avant l'historique, daté par le journal d'audit),
  /// DEPARTURE_UNKNOWN (départ d'avant l'historique sans date : compté), DEPARTURE_DIRECTION (date fixée par la
  /// direction pendant la vérification), EXCLUDED (exclusion validée : pas comptée).
  basis         String
  departureDate DateTime?    @db.Date

  @@unique([countId, enrollmentId])
  @@index([tenantId, enrollmentId])
  @@map("billing_count_items")
}

enum CountCorrectionKind {
  /// Exclusion d'une inscription annulée pour erreur de saisie (règle du 13 novembre 2026), justifiée puis validée.
  EXCLUSION
  /// Date d'un départ enregistré avant l'historique des inscriptions, fixée par la direction pendant la vérification
  /// (D-G5-16 A) : jamais après la date du journal d'audit.
  DEPARTURE_DATE
}

enum CountCorrectionStatus {
  PENDING
  VALIDATED
  REFUSED
}

/// Demande de correction d'un comptage par la direction (espace de l'école), avec sa justification et, au besoin, un
/// justificatif. Une exclusion est validée par la direction tant qu'aucun document émis n'est touché (D-G5-13 B ; les
/// documents arrivent au lot G5c). Jamais supprimée ; seule la décision s'inscrit, une fois.
model CountCorrection {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  kind            CountCorrectionKind
  enrollmentId    String                @db.Uuid
  enrollment      Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  /// Comptage en vérification au moment de la demande.
  countId         String                @db.Uuid
  count           BillingCount          @relation(fields: [countId], references: [id], onDelete: Restrict)
  departureDate   DateTime?             @db.Date
  justification   String
  fileKey         String?
  fileMime        String?
  fileSize        Int?
  status          CountCorrectionStatus
  requestedById   String?               @db.Uuid
  requestedByName String
  requestedAt     DateTime              @default(now())
  /// school (direction) ; platform (Super Admin, quand un document émis est touché : lot G5c).
  decidedByKind   String?
  decidedById     String?               @db.Uuid
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  /// Ligne d'avoir émise pour cette exclusion après un document (lot G5c) : une seule.
  creditLine      BillingDocumentLine?

  @@index([tenantId, enrollmentId])
  @@index([countId])
  @@map("count_corrections")
}

/// Document provisoire de Cahiora (lot G5c) : proforma de l'abonnement (première facture, complément d'une
/// régularisation, relevé à 0 F), avoir, devis ou proforma de prestations ; jamais une facture fiscale (cahier des
/// charges G5 §16 ; factures fiscales au lot G5f). Le client est le groupe (compte client) ; une ligne par
/// établissement. Zone de la plateforme, en ajout seul (déclencheur forbid_change) ; émis par la seule fonction
/// issue_billing_document, qui refait les contrôles et les calculs.
model BillingDocument {
  id                String                @id @default(uuid()) @db.Uuid
  groupId           String                @map("group_id") @db.Uuid
  group             SchoolGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  kind              BillingDocumentKind
  /// Référence provisoire « PROV-… », jamais un numéro de facture.
  reference         String                @unique
  currency          String
  issueDate         DateTime              @db.Date
  /// Échéance : dernier jour de grâce pour la première facture (D-G5-30) ; ailleurs INFORMATION MANQUANTE.
  dueDate           DateTime?             @db.Date
  total             Int
  yearLabel         String?
  /// Avoir : document d'abonnement touché ; proforma de prestations : devis repris.
  relatedDocumentId String?               @db.Uuid
  related           BillingDocument?      @relation("BillingDocumentRelated", fields: [relatedDocumentId], references: [id], onDelete: Restrict)
  relatedBy         BillingDocument[]     @relation("BillingDocumentRelated")
  /// Instantané au jour de l'émission : client, établissements, tarif, décisions en vigueur, mention.
  data              Json
  /// system (tâche planifiée) ou platform (Super Admin).
  createdByKind     String
  createdById       String?               @db.Uuid
  createdByName     String
  createdAt         DateTime              @default(now())
  lines             BillingDocumentLine[]

  @@index([groupId, issueDate])
  @@map("billing_documents")
}

/// Ligne d'un document provisoire : abonnement d'un établissement à la date d'un comptage figé (calcul complet),
/// avoir après une exclusion validée, ou prestation. En ajout seul.
model BillingDocumentLine {
  id             String                @id @default(uuid()) @db.Uuid
  documentId     String                @db.Uuid
  document       BillingDocument       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  tenantId       String                @map("tenant_id") @db.Uuid
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  position       Int
  label          String
  amount         Int
  countId        String?               @unique @db.Uuid
  count          BillingCount?         @relation(fields: [countId], references: [id], onDelete: Restrict)
  countKind      BillingCountKind?
  referenceDate  DateTime?             @db.Date
  pupils         Int?
  pupilsChange   Int?
  pricePerPupil  Int?
  minimum        Int?
  minimumApplied Boolean?
  fullYear       Int?
  shareMonths    Int?
  shareOf        Int?
  yearAmount     Int?
  alreadyBilled  Int?
  relatedLineId  String?               @db.Uuid
  relatedLine    BillingDocumentLine?  @relation("BillingDocumentLineRelated", fields: [relatedLineId], references: [id], onDelete: Restrict)
  credits        BillingDocumentLine[] @relation("BillingDocumentLineRelated")
  correctionId   String?               @unique @db.Uuid
  correction     CountCorrection?      @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  serviceId      String?               @db.Uuid
  service        Service?              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceName    String?
  quantity       Int?
  unitPrice      Int?
  priceBasis     String?

  @@unique([documentId, position])
  @@index([tenantId])
  @@map("billing_document_lines")
}

enum BillingDocumentKind {
  SUBSCRIPTION
  CREDIT_NOTE
  SERVICE_QUOTE
  SERVICE_PROFORMA
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  phone     String?
  /// Photo du site affichée sur la page d'accueil publique (envoyée par la direction).
  photoKey  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes      Class[]
  rooms        Room[]
  applications Application[]

  @@unique([tenantId, name])
  @@map("sites")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  terms             Term[]
  classes           Class[]
  enrollments       Enrollment[]
  internshipPeriods InternshipPeriod[]
  billingCounts     BillingCount[]

  @@unique([tenantId, label])
  @@map("academic_years")
}

/// Période d'évaluation (trimestre ou semestre).
model Term {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  position       Int
  /// Poids de la période dans la moyenne annuelle (ex. T1 × 1, T2 × 1, T3 × 2).
  weight         Decimal      @default(1) @db.Decimal(4, 2)
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date

  assessments Assessment[]
  reportRuns  ReportCardRun[]

  @@unique([academicYearId, position])
  @@map("terms")
}

enum Cycle {
  MATERNELLE
  PRIMAIRE
  COLLEGE
  LYCEE_GENERAL
  LYCEE_TECHNIQUE
}

/// Filière ou série (ex. Électrotechnique F3, Génie civil F4, Enseignement général).
model Track {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  cycle    Cycle
  classes  Class[]

  @@unique([tenantId, code])
  @@map("tracks")
}

model Level {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  cycle       Cycle
  position    Int
  /// Niveau de l'année suivante pour un élève admis (5e → 4e), défini par la direction : sert à proposer la classe
  /// à la réinscription (corrections du lot G4). Vide : aucune proposition pour un élève admis.
  nextLevelId String? @db.Uuid
  nextLevel   Level?  @relation("LevelPassage", fields: [nextLevelId], references: [id], onDelete: SetNull)
  fromLevels  Level[] @relation("LevelPassage")
  classes     Class[]

  @@unique([tenantId, name])
  @@map("levels")
}

model Class {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  siteId         String       @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id])
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  levelId        String       @db.Uuid
  level          Level        @relation(fields: [levelId], references: [id])
  trackId        String?      @db.Uuid
  track          Track?       @relation(fields: [trackId], references: [id])
  name           String
  capacity       Int?
  /// Professeur principal.
  headTeacherId  String?      @db.Uuid
  headTeacher    User?        @relation("HeadTeacher", fields: [headTeacherId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subjects      ClassSubject[]
  enrollments   Enrollment[]
  attendance    AttendanceSession[]
  reportRuns    ReportCardRun[]
  reportCards   ReportCard[]
  announcements Announcement[]

  @@unique([academicYearId, name])
  @@index([tenantId, siteId])
  @@map("classes")
}

model Room {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  siteId   String          @db.Uuid
  site     Site            @relation(fields: [siteId], references: [id])
  name     String
  /// Salle de classe, atelier ou laboratoire (travaux pratiques du lycée technique).
  kind     RoomKind        @default(CLASSROOM)
  capacity Int?
  slots    TimetableSlot[]

  @@unique([siteId, name])
  @@map("rooms")
}

enum RoomKind {
  CLASSROOM
  WORKSHOP
  LAB
  OTHER
}

// ---------------------------------------------------------------- Identité

enum RoleCode {
  DIRECTION
  SECRETARIAT
  ENSEIGNANT
  VIE_SCOLAIRE
  COMPTABLE
  PARENT
  ELEVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  phone              String?
  email              String?
  passwordHash       String
  firstName          String
  lastName           String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  totpSecret         String?
  totpEnabled        Boolean    @default(false)
  /// Pas de temps (30 s) du dernier code accepté : un code ne sert qu'une fois (SEC-022).
  totpLastStep       Int?
  /// Récupération validée : le compte doit configurer une nouvelle double authentification avant tout autre écran.
  twoFactorReenroll  Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roles            UserRole[]
  recoveryCodes    RecoveryCode[]
  recoveryRequests TwoFactorRecoveryRequest[]
  sessions         Session[]
  otps             OtpCode[]
  assignments      TeacherAssignment[]
  /// Matières que ce professeur enseigne (une ou plusieurs), saisies par la direction.
  teacherSubjects  TeacherSubject[]
  headOf           Class[]                    @relation("HeadTeacher")
  notifications    Notification[]
  guardian         Guardian?
  student          Student?

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("users")
}

/// Rôle d'un utilisateur, éventuellement limité à un site. Un compte peut cumuler plusieurs rôles (CDC §2).
model UserRole {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     RoleCode
  siteId   String?  @db.Uuid

  @@unique([userId, role, siteId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}

/// Code de récupération de la double authentification : seule son empreinte est gardée, il ne sert qu'une fois.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

enum RecoveryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

/// Demande de récupération de la double authentification (téléphone et codes perdus) : vérification
/// d'identité notée, validée par une autre personne que le demandeur, code de réactivation remis en main propre.
model TwoFactorRecoveryRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  userId              String                @db.Uuid
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedById       String?               @db.Uuid
  requestedByName     String
  requestedByPlatform Boolean               @default(false)
  reason              String
  identityCheck       String
  identityNote        String?
  /// Compte Direction, ou école sans seconde personne habilitée : seul le Super Admin valide.
  requiresPlatform    Boolean               @default(false)
  status              RecoveryRequestStatus @default(PENDING)
  decidedById         String?               @db.Uuid
  decidedByName       String?
  decidedByPlatform   Boolean               @default(false)
  decisionNote        String?
  decidedAt           DateTime?
  expiresAt           DateTime
  activationHash      String?
  activationExpiresAt DateTime?
  activationAttempts  Int                   @default(0)
  completedAt         DateTime?
  createdAt           DateTime              @default(now())

  @@index([tenantId, status])
  @@index([userId])
  @@map("two_factor_recovery_requests")
}

enum OtpPurpose {
  PASSWORD_RESET
  LOGIN
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@map("otp_codes")
}

// ---------------------------------------------------------------- Élèves et familles

enum Sex {
  M
  F
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

model Student {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  /// Matricule unique et permanent (CDC §4.1), sert aussi de référence de paiement.
  matricule  String
  firstName  String
  lastName   String
  sex        Sex?
  birthDate  DateTime?     @db.Date
  birthPlace String?
  photoUrl   String?
  /// Photo d'identité envoyée par l'école (fichier privé, servi par lien signé).
  photoKey   String?
  allergies  String?
  status     StudentStatus @default(ACTIVE)
  userId     String?       @unique @db.Uuid
  user       User?         @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  attendance        AttendanceRecord[]
  grades            Grade[]
  reportCards       ReportCard[]
  invoices          Invoice[]
  payments          Payment[]
  documents         Document[]
  sanctions         Sanction[]
  internships       InternshipPlacement[]
  annualDecisions   AnnualDecision[]
  honors            PublicHonor[]
  files             StudentFile[]
  /// Doublons possibles (lot G4) : ce dossier, créé malgré l'alerte, ou le dossier existant qui lui ressemble.
  duplicatesAsNew   DuplicateReview[]     @relation("DuplicateNew")
  duplicatesAsOther DuplicateReview[]     @relation("DuplicateOther")

  @@unique([tenantId, matricule])
  @@index([tenantId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  firstName String
  lastName  String
  phone     String
  email     String?
  address   String?
  userId    String?  @unique @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  students StudentGuardian[]

  @@index([tenantId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  studentId  String   @db.Uuid
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String   @db.Uuid
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relation   String
  isPrimary  Boolean  @default(false)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  /// Annulée par la direction (saisie par erreur, doublon) : jamais supprimée, motif obligatoire (lot G4).
  CANCELLED
}

/// Inscription d'un nouvel élève, ou réinscription d'un élève qui a déjà un dossier dans l'école (lot G4).
enum EnrollmentType {
  NEW
  RETURNING
}

/// Inscription : élève × classe × année. Une seule par élève et par année ; jamais supprimée (lot G4).
model Enrollment {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  studentId        String             @db.Uuid
  student          Student            @relation(fields: [studentId], references: [id])
  classId          String             @db.Uuid
  class            Class              @relation(fields: [classId], references: [id])
  academicYearId   String             @db.Uuid
  academicYear     AcademicYear       @relation(fields: [academicYearId], references: [id])
  status           EnrollmentStatus   @default(ACTIVE)
  enrolledAt       DateTime           @default(now())
  /// Inscription ou réinscription ; vide pour les inscriptions enregistrées avant le lot G4.
  type             EnrollmentType?
  /// Départ en cours d'année (transfert, abandon) : date de sortie et motif.
  exitDate         DateTime?          @db.Date
  exitReason       String?
  /// Annulation par la direction : date, motif, auteur. Une inscription annulée ne compte plus à partir de cette date.
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledById    String?            @db.Uuid
  events           EnrollmentEvent[]
  /// Lot G5b : lignes des comptages des élèves facturables et demandes de correction de la direction.
  countItems       BillingCountItem[]
  countCorrections CountCorrection[]

  @@unique([studentId, academicYearId])
  @@index([classId])
  @@index([tenantId, academicYearId])
  @@map("enrollments")
}

enum EnrollmentEventKind {
  ENROLLED
  REENROLLED
  CLASS_CHANGED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
  REINSTATED
}

/// Historique des inscriptions, en ajout seul (lot G4) : aucune ligne n'est modifiée ni supprimée, même par le propriétaire.
model EnrollmentEvent {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  enrollmentId String              @db.Uuid
  enrollment   Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  kind         EnrollmentEventKind
  /// Détail : classe d'avant et d'après, date et motif de sortie, motif d'annulation…
  data         Json?
  actorId      String?             @db.Uuid
  actorName    String?
  createdAt    DateTime            @default(now())

  @@index([enrollmentId, createdAt])
  @@map("enrollment_events")
}

enum DuplicateStatus {
  /// Signalé, en attente de la décision de la direction.
  PENDING
  /// Deux élèves différents : l'alerte ne revient plus pour cette paire.
  DIFFERENT
  /// Même élève : la direction annule elle-même l'inscription en trop (jamais de fusion automatique).
  SAME
}

/// Doublon possible entre deux dossiers d'élèves (lot G4). Le dossier le plus récent est `student`, l'ancien `other`.
model DuplicateReview {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  studentId    String          @db.Uuid
  student      Student         @relation("DuplicateNew", fields: [studentId], references: [id], onDelete: Restrict)
  otherId      String          @db.Uuid
  other        Student         @relation("DuplicateOther", fields: [otherId], references: [id], onDelete: Restrict)
  /// Ce qui rapproche les deux dossiers : NOM_NAISSANCE (même nom, même date de naissance) ou NOM_TELEPHONE (même nom, un responsable en commun).
  reason       String
  status       DuplicateStatus @default(PENDING)
  /// Motif saisi par la personne qui a créé le dossier malgré l'alerte.
  note         String?
  createdById  String?         @db.Uuid
  decidedById  String?         @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime        @default(now())

  @@unique([studentId, otherId])
  @@index([tenantId, status])
  @@map("duplicate_reviews")
}

enum ApplicationStatus {
  RECU
  INCOMPLET
  EN_TEST
  ACCEPTE
  REFUSE
  LISTE_ATTENTE
  INSCRIT
}

/// Pré-inscription déposée depuis le site public (CDC §4.1, étapes 1 à 4).
model Application {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  reference        String
  studentFirstName String
  studentLastName  String
  sex              Sex?
  birthDate        DateTime?         @db.Date
  previousSchool   String?
  wantedLevel      String
  wantedTrack      String?
  wantedSite       String?
  /// Site choisi par la famille (GRP-003) : un personnel limité à un site ne voit que les demandes de son site.
  siteId           String?           @db.Uuid
  site             Site?             @relation(fields: [siteId], references: [id])
  guardianName     String
  guardianPhone    String
  guardianEmail    String?
  message          String?
  status           ApplicationStatus @default(RECU)
  testResult       String?
  notes            String?
  studentId        String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, reference])
  @@index([tenantId, siteId])
  @@map("applications")
}

// ---------------------------------------------------------------- Pédagogie

model Subject {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  code      String
  name      String
  /// Matière de travaux pratiques d'atelier.
  practical Boolean @default(false)

  classSubjects ClassSubject[]
  teachers      TeacherSubject[]

  @@unique([tenantId, code])
  @@map("subjects")
}

/// Matière qu'un professeur enseigne : sert à proposer les bons professeurs lors des affectations aux classes.
model TeacherSubject {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  teacherId String  @db.Uuid
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String  @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

/// Matière enseignée dans une classe, avec son coefficient (coefficient par niveau et série, CDC §3.3).
model ClassSubject {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  classId     String  @db.Uuid
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String  @db.Uuid
  subject     Subject @relation(fields: [subjectId], references: [id])
  coefficient Decimal @default(1) @db.Decimal(4, 2)

  assignments TeacherAssignment[]
  slots       TimetableSlot[]
  assessments Assessment[]
  lessons     Lesson[]

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

/// Service : enseignant × matière × classe.
model TeacherAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  teacherId      String       @db.Uuid
  teacher        User         @relation(fields: [teacherId], references: [id])
  classSubjectId String       @db.Uuid
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classSubjectId])
  @@map("teacher_assignments")
}

/// Créneau hebdomadaire récurrent. Heures en minutes depuis minuit.
model TimetableSlot {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  classSubjectId String       @db.Uuid
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  roomId         String?      @db.Uuid
  room           Room?        @relation(fields: [roomId], references: [id])
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime     @default(now())

  changes TimetableChange[]

  @@index([tenantId, dayOfWeek])
  @@map("timetable_slots")
}

enum TimetableChangeKind {
  CANCELLED
  MOVED
  ROOM_CHANGED
}

/// Modification ponctuelle d'un créneau à une date donnée (absence de professeur, déplacement, changement de salle).
model TimetableChange {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  slotId         String              @db.Uuid
  slot           TimetableSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date           DateTime            @db.Date
  kind           TimetableChangeKind
  newDate        DateTime?           @db.Date
  newStartMinute Int?
  newEndMinute   Int?
  newRoomId      String?             @db.Uuid
  reason         String?
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())

  @@unique([slotId, date])
  @@map("timetable_changes")
}

/// Séance du cahier de texte.
model Lesson {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  classSubjectId String       @db.Uuid
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  title          String
  content        String
  homework       String?
  homeworkDue    DateTime?    @db.Date
  authorId       String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([classSubjectId, date])
  @@map("lessons")
}

// ---------------------------------------------------------------- Vie scolaire

model AttendanceSession {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  classId        String   @db.Uuid
  class          Class    @relation(fields: [classId], references: [id])
  classSubjectId String?  @db.Uuid
  date           DateTime @db.Date
  startMinute    Int
  takenById      String   @db.Uuid
  takenAt        DateTime @default(now())

  records AttendanceRecord[]

  @@unique([classId, date, startMinute])
  @@map("attendance_sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum JustificationStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

model AttendanceRecord {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  sessionId           String              @db.Uuid
  session             AttendanceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId           String              @db.Uuid
  student             Student             @relation(fields: [studentId], references: [id])
  status              AttendanceStatus
  minutesLate         Int?
  justification       JustificationStatus @default(NONE)
  justificationReason String?
  justificationFile   String?
  justifiedById       String?             @db.Uuid
  reviewedById        String?             @db.Uuid
  reviewedAt          DateTime?

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

enum SanctionStatus {
  PROPOSED
  VALIDATED
  REJECTED
}

model Sanction {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  studentId     String         @db.Uuid
  student       Student        @relation(fields: [studentId], references: [id])
  kind          String
  reason        String
  date          DateTime       @db.Date
  status        SanctionStatus @default(PROPOSED)
  proposedById  String         @db.Uuid
  validatedById String?        @db.Uuid
  createdAt     DateTime       @default(now())

  @@map("sanctions")
}

// ---------------------------------------------------------------- Évaluation

enum AssessmentKind {
  INTERROGATION
  DEVOIR
  COMPOSITION
}

model Assessment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  classSubjectId String         @db.Uuid
  classSubject   ClassSubject   @relation(fields: [classSubjectId], references: [id])
  termId         String         @db.Uuid
  term           Term           @relation(fields: [termId], references: [id])
  title          String
  kind           AssessmentKind
  weight         Decimal        @default(1) @db.Decimal(4, 2)
  maxScore       Decimal        @default(20) @db.Decimal(5, 2)
  date           DateTime       @db.Date
  published      Boolean        @default(false)
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())

  grades Grade[]

  @@index([classSubjectId, termId])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  assessmentId String     @db.Uuid
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  studentId    String     @db.Uuid
  student      Student    @relation(fields: [studentId], references: [id])
  /// Note brute sur maxScore de l’évaluation ; null = non notée.
  score        Decimal?   @db.Decimal(5, 2)
  absent       Boolean    @default(false)
  exempt       Boolean    @default(false)
  comment      String?
  updatedById  String     @db.Uuid
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@map("grades")
}

/// Circuit de validation des bulletins d'une classe pour une période (CDC §3.3).
enum ReportRunStatus {
  SAISIE
  CONTROLE
  CONSEIL
  VALIDE
  PUBLIE
}

model ReportCardRun {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  classId   String          @db.Uuid
  class     Class           @relation(fields: [classId], references: [id])
  termId    String          @db.Uuid
  term      Term            @relation(fields: [termId], references: [id])
  status    ReportRunStatus @default(SAISIE)
  history   Json            @default("[]")
  updatedAt DateTime        @updatedAt

  @@unique([classId, termId])
  @@map("report_card_runs")
}

model ReportCard {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  studentId       String    @db.Uuid
  student         Student   @relation(fields: [studentId], references: [id])
  classId         String    @db.Uuid
  class           Class     @relation(fields: [classId], references: [id])
  termId          String    @db.Uuid
  average         Decimal?  @db.Decimal(5, 2)
  rank            Int?
  classSize       Int
  distinction     String?
  appreciation    String?
  councilDecision String?
  absencesCount   Int       @default(0)
  verifyCode      String    @unique
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  items ReportCardItem[]

  @@unique([studentId, termId])
  @@map("report_cards")
}

model ReportCardItem {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  reportCardId String     @db.Uuid
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subjectName  String
  coefficient  Decimal    @db.Decimal(4, 2)
  average      Decimal?   @db.Decimal(5, 2)
  classAverage Decimal?   @db.Decimal(5, 2)
  minAverage   Decimal?   @db.Decimal(5, 2)
  maxAverage   Decimal?   @db.Decimal(5, 2)
  rank         Int?
  teacherName  String?
  appreciation String?

  @@map("report_card_items")
}

/// Appréciation d'un enseignant pour un élève, une matière et une période.
model Appreciation {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @db.Uuid
  classSubjectId String   @db.Uuid
  termId         String   @db.Uuid
  text           String
  authorId       String   @db.Uuid
  updatedAt      DateTime @updatedAt

  @@unique([studentId, classSubjectId, termId])
  @@map("appreciations")
}

// ---------------------------------------------------------------- Finances

/// Tarif du catalogue (scolarité, inscription, tenue...). Les montants sont saisis par l'école.
model FeeType {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  academicYearId String      @db.Uuid
  name           String
  amount         Int
  levelId        String?     @db.Uuid
  trackId        String?     @db.Uuid
  dueDate        DateTime?   @db.Date
  active         Boolean     @default(true)
  /// À qui le frais s'applique : tous, nouveaux inscrits (inscription) ou anciens élèves (réinscription).
  audience       FeeAudience @default(ALL)
  /// Facultatif (activité extra-classe, paiement en une fois) : jamais facturé d'office, seulement à la demande.
  optional       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@map("fee_types")
}

enum FeeAudience {
  ALL
  NEW
  RETURNING
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  number      String
  studentId   String        @db.Uuid
  student     Student       @relation(fields: [studentId], references: [id])
  label       String
  total       Int
  paid        Int           @default(0)
  dueDate     DateTime      @db.Date
  status      InvoiceStatus @default(OPEN)
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([studentId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeTypeId String? @db.Uuid
  label     String
  amount    Int

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  CHEQUE
  TRANSFER
  MOBILE_MONEY_DESK
  ONLINE
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  invoiceId      String        @db.Uuid
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  studentId      String        @db.Uuid
  student        Student       @relation(fields: [studentId], references: [id])
  amount         Int
  method         PaymentMethod
  /// Fournisseur pour les paiements en ligne (sandbox, cinetpay, paydunya).
  provider       String?
  /// Opérateur choisi par le payeur (MTN MoMo, Moov Money...).
  operator       String?
  providerRef    String?
  /// Identifiant de transaction envoyé au fournisseur, unique.
  transactionId  String        @unique
  /// Clé anti-doublon envoyée par le poste de caisse, unique dans l'école (SEC-008).
  idempotencyKey String?
  status         PaymentStatus @default(INITIATED)
  payerPhone     String?
  receivedById   String?       @db.Uuid
  rawCallback    Json?
  createdAt      DateTime      @default(now())
  confirmedAt    DateTime?

  receipt Receipt?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("payments")
}

/// Reçu numéroté. Jamais supprimé : il s'annule par un avoir (CDC §4.4).
model Receipt {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  number              String
  paymentId           String    @unique @db.Uuid
  payment             Payment   @relation(fields: [paymentId], references: [id])
  verifyCode          String    @unique
  issuedAt            DateTime  @default(now())
  cancelledAt         DateTime?
  cancelReason        String?
  cancelledById       String?   @db.Uuid
  /// Demande d'annulation du comptable, en attente de la validation de la direction (SEC-015).
  cancelRequestedAt   DateTime?
  cancelRequestedById String?   @db.Uuid
  cancelRequestReason String?

  @@unique([tenantId, number])
  @@map("receipts")
}

/// Clôture de caisse journalière par caissier.
model CashClosing {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  siteId     String?  @db.Uuid
  date       DateTime @db.Date
  cashierId  String   @db.Uuid
  expected   Int
  counted    Int
  difference Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, cashierId, date])
  @@map("cash_closings")
}

/// Compteurs séquentiels par tenant (matricules, factures, reçus...).
model Counter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("counters")
}

// ---------------------------------------------------------------- Communication

enum Audience {
  ALL
  PARENTS
  STAFF
  TEACHERS
  CLASS
}

model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  body      String
  audience  Audience
  classId   String?  @db.Uuid
  class     Class?   @relation(fields: [classId], references: [id])
  siteId    String?  @db.Uuid
  urgent    Boolean  @default(false)
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("announcements")
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  kind      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus  @default(QUEUED)
  error     String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Journal des SMS envoyés aux familles (paiement, absence, rappel, bulletin...). Les SMS de mot de passe ou de code
/// n'y sont jamais écrits. Un responsable sans compte Cahiora reçoit aussi les SMS : d'où le numéro et non un compte.
model SmsMessage {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  kind      String
  phone     String
  body      String
  /// Nombre de SMS facturés par l'opérateur (160 caractères par SMS, 153 au-delà d'un SMS).
  segments  Int                @default(1)
  studentId String?            @db.Uuid
  userId    String?            @db.Uuid
  status    NotificationStatus @default(QUEUED)
  error     String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([tenantId, createdAt])
  @@map("sms_messages")
}

// ---------------------------------------------------------------- Documents et audit

enum DocumentKind {
  CERTIFICAT_SCOLARITE
  ATTESTATION_INSCRIPTION
  CARTE_SCOLAIRE
  ATTESTATION_PAIEMENT
}

model Document {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  kind       DocumentKind
  number     String
  studentId  String       @db.Uuid
  student    Student      @relation(fields: [studentId], references: [id])
  verifyCode String       @unique
  data       Json
  issuedById String       @db.Uuid
  issuedAt   DateTime     @default(now())

  @@unique([tenantId, number])
  @@map("documents")
}

/// Registre public de vérification des QR codes, sans donnée personnelle superflue.
/// Hors RLS : consulté par la page publique /verifier/{code}.
model VerificationEntry {
  code      String    @id
  tenantId  String    @map("tenant_id") @db.Uuid
  kind      String
  summary   String
  issuedAt  DateTime
  revokedAt DateTime?

  @@map("verification_entries")
}

/// Journal d'audit : insertion seule (UPDATE et DELETE interdits par trigger).
