# Connexion applicative : rôle sans privilège, soumis à la Row Level Security.
DATABASE_URL=postgresql://erp_app:erp_app_dev@localhost:5432/erp
# Connexion propriétaire : migrations et seed uniquement.
DATABASE_ADMIN_URL=postgresql://erp_owner:erp_owner_dev@localhost:5432/erp
# Super Admin (rôle erp_platform, voir infra/postgres/role-plateforme.sh) ; vide = rôle propriétaire.
DATABASE_PLATFORM_URL=postgresql://erp_platform:erp_platform_dev@localhost:5432/erp
REDIS_URL=redis://localhost:6379
PORT=4000
# Origine du site web (CORS et liens envoyés par SMS).
WEB_ORIGIN=http://localhost:3000
# Secrets JWT : à générer (openssl rand -base64 48). Ne jamais réutiliser ces valeurs en production.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Clé de chiffrement applicatif des secrets 2FA (32 octets en base64).
APP_ENCRYPTION_KEY=
# Paiement en ligne : sandbox | cinetpay | paydunya
PAYMENT_PROVIDER=sandbox
# INFORMATION MANQUANTE : identifiants CinetPay de l'école (contrat non signé).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# INFORMATION MANQUANTE : identifiants PayDunya.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# URL publique de l'API pour les retours de paiement (webhook).
PUBLIC_API_URL=http://localhost:4000
# SMS : console | (fournisseur à choisir — INFORMATION MANQUANTE)
SMS_PROVIDER=console
# Avec SMS_PROVIDER=bulkgate : portail BulkGate > Modules et API > API > Simple API (identifiant et jeton).
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
# Nom d'expéditeur par défaut, une fois enregistré (11 caractères, sans accent). Chaque école peut avoir le sien (Super Admin).
SMS_SENDER=
# PDF : URL du service Gotenberg ; vide = documents HTML imprimables.
GOTENBERG_URL=

# École servie quand l’adresse ne désigne aucune école (installation à une seule école).
TENANT_SLUG=saint-kisito
# Plateforme multi-écoles : domaine des adresses <identifiant>.<domaine>. Vide = une seule école.
PLATFORM_DOMAIN=
